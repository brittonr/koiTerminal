new file mode 100644
index 0000000..6439f3f
--- /dev/null
+++ b/private/virtualizationdisplay.te
@@ -0,0 +1,13 @@
+# VM-owned display broker only. Do not expose virtualization_service to apps.
+type virtualizationdisplay_service, app_api_service, service_manager_type;
+add_service(virtualizationservice, virtualizationdisplay_service)
+
+# Every broker lookup checks MANAGE/USE_CUSTOM_VM and the full allocating UID.
+binder_call(untrusted_app, virtualizationservice)
+
+is_flag_enabled(RELEASE_AVF_SUPPORT_CUSTOM_VM_WITH_PARAVIRTUALIZED_DEVICES, `
+    # Surface producers and cursor FDs use kernel Binder, not Binder RPC.
+    # Native DisplayService checks the owning UID on every transaction.
+    binder_call(untrusted_app, crosvm)
+    binder_call(crosvm, untrusted_app)
+')
