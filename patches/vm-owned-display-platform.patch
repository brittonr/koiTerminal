--- /dev/null
+++ b/android/virtualizationservice/aidl/android/system/virtualizationservice/IVirtualMachineDisplayService.aidl
@@ -0,0 +1,19 @@
+/* Copyright 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.system.virtualizationservice;
+
+/** Kernel-Binder display broker. This is not the privileged internal VM service. */
+interface IVirtualMachineDisplayService {
+    const String SERVICE_NAME = "android.system.virtualizationdisplay";
+    const int ERROR_NOT_READY = 1;
+
+    /**
+     * Returns the display of the caller's registered VM, without waiting for another VM.
+     * Requires MANAGE_VIRTUAL_MACHINE and USE_CUSTOM_VIRTUAL_MACHINE. The owner is checked
+     * against the full kernel Binder calling UID captured when this CID was allocated.
+     * Throws SecurityException for an unknown/foreign CID, or ERROR_NOT_READY if unpublished.
+     * The returned service independently enforces the owner's UID on every transaction.
+     */
+    IBinder getDisplayService(int cid);
+}
diff --git a/libs/android_display_backend/vm_display_access.h b/libs/android_display_backend/vm_display_access.h
new file mode 100644
index 000000000..5742ea7d0
--- /dev/null
+++ b/libs/android_display_backend/vm_display_access.h
@@ -0,0 +1,19 @@
+// Copyright 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <sys/types.h>
+
+// DisplayService serializes this state with its transaction/lifecycle mutex.
+class VmDisplayAccess {
+public:
+    explicit VmDisplayAccess(uid_t owner) : mOwner(owner) {}
+
+    bool permits(uid_t caller) const { return mActive && caller == mOwner; }
+    void revoke() { mActive = false; }
+
+private:
+    const uid_t mOwner;
+    bool mActive = true;
+};
diff --git a/libs/android_display_backend/vm_display_access_test.cpp b/libs/android_display_backend/vm_display_access_test.cpp
new file mode 100644
index 000000000..89814df94
--- /dev/null
+++ b/libs/android_display_backend/vm_display_access_test.cpp
@@ -0,0 +1,25 @@
+// Copyright 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include "vm_display_access.h"
+
+#include <cstdio>
+
+int main() {
+    constexpr uid_t owner = 10387;
+    VmDisplayAccess original(owner);
+    VmDisplayAccess other(owner + 1);
+    if (!original.permits(owner) || original.permits(owner + 1) ||
+        original.permits(owner + 100000) || original.permits(0) || other.permits(owner)) {
+        std::fputs("FAIL: display handle crossed a UID or Android-user boundary\n", stderr);
+        return 1;
+    }
+    original.revoke();
+    VmDisplayAccess replacement(owner);
+    if (original.permits(owner) || original.permits(owner + 1) || !replacement.permits(owner)) {
+        std::fputs("FAIL: a retired display remained usable or revoked its replacement\n", stderr);
+        return 1;
+    }
+    std::puts("PASS: owner-only, full Android UID, transferred-handle refusal, independent revocation");
+    return 0;
+}
