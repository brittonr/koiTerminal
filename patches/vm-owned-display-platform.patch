+#include <fuzzbinder/libbinder_ndk_driver.h>
+#include <fuzzer/FuzzedDataProvider.h>
+
+#include <cstdlib>
+
+using aidl::android::system::virtualizationservice::IVirtualMachineDisplayService;
+
+// Device-only: exercise the real broker on an OS containing this service.
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+    static const ndk::SpAIBinder service{
+            AServiceManager_waitForService(IVirtualMachineDisplayService::SERVICE_NAME)};
+    if (service.get() == nullptr) std::abort();
+    android::fuzzService(service.get(), FuzzedDataProvider(data, size));
+    if (AIBinder_ping(service.get()) != STATUS_OK) std::abort();
+    return 0;
+}
